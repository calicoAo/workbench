NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=mysql://workbench:workbench_password@127.0.0.1:3307/personal_workbench
JWT_SECRET=change_me_before_deploy
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# DeepSeek task decomposition (server-side only)
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Native web_search is available on deepseek-v4-pro; used only by Library AI search.
DEEPSEEK_LIBRARY_SEARCH_MODEL=deepseek-v4-pro

# TMDB movies, series, and animation movies/series
# Media origins below document the fixed allowlist; custom media origins are not fetched.
TMDB_API_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p
TMDB_API_READ_ACCESS_TOKEN=
# Optional private HTTP CONNECT proxy for api.themoviedb.org only
TMDB_PROXY_URL=

# Open Library books (no API key; identify the application with a real contact)
OPEN_LIBRARY_BASE_URL=https://openlibrary.org
OPEN_LIBRARY_COVERS_BASE_URL=https://covers.openlibrary.org
OPEN_LIBRARY_USER_AGENT=PersonalWorkbench/0.1 (contact: your-email@example.com)

# IGDB games (optional / gated until Twitch credentials are available; server-side only)
IGDB_API_BASE_URL=https://api.igdb.com/v4
TWITCH_OAUTH_URL=https://id.twitch.tv/oauth2/token
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Independent signing key; generate with: openssl rand -hex 32
MEDIA_IMPORT_TOKEN_SECRET=

# Optional public DNS servers for direct media hosts when local VPN DNS returns synthetic/private IPs
MEDIA_PUBLIC_DNS=
