[Unit]
Description=Private TMDB CONNECT bridge for the workbench API container
After=docker.service
Requires=docker.service

[Service]
Type=simple
User=nobody
Group=nobody
ExecStart=/usr/bin/python3 -u /opt/personal-workbench-proxy/tmdb-connect-bridge.py
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
