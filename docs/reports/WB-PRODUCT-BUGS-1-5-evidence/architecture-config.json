{
  "entrypoints": [
    {
      "path": "apps/web/src/features/finance/index.tsx",
      "warnLines": 400
    },
    {
      "path": "apps/web/src/features/settings/index.tsx",
      "warnLines": 800
    },
    {
      "path": "apps/web/src/app/shell/index.tsx",
      "warnLines": 400
    },
    {
      "path": "apps/web/src/features/tasks/index.tsx",
      "warnLines": 400
    },
    {
      "path": "apps/web/src/features/calendar/index.tsx",
      "warnLines": 400
    }
  ],
  "boundaryRules": [
    {
      "name": "settings-does-not-own-finance-presentation",
      "from": [
        "apps/web/src/features/settings/**"
      ],
      "denyImports": [
        "apps/web/src/features/finance",
        "apps/web/src/features/finance/**"
      ],
      "severity": "error"
    },
    {
      "name": "shell-uses-finance-public-surface",
      "from": [
        "apps/web/src/app/shell/**"
      ],
      "denyImports": [
        "apps/web/src/features/finance/**"
      ],
      "severity": "error"
    },
    {
      "name": "finance-maintenance-has-no-settings-owner-dependency",
      "from": [
        "apps/web/src/features/finance/**"
      ],
      "denyImports": [
        "apps/web/src/features/settings",
        "apps/web/src/features/settings/**"
      ],
      "severity": "error"
    },
    {
      "name": "shell-consumes-task-calendar-public-surfaces",
      "from": [
        "apps/web/src/app/shell/**"
      ],
      "denyImports": [
        "apps/web/src/features/tasks/**",
        "apps/web/src/features/calendar/**"
      ],
      "severity": "error"
    },
    {
      "name": "calendar-does-not-reach-into-task-internals",
      "from": [
        "apps/web/src/features/calendar/**"
      ],
      "denyImports": [
        "apps/web/src/features/tasks/**"
      ],
      "severity": "error"
    },
    {
      "name": "tasks-do-not-reach-into-calendar-internals",
      "from": [
        "apps/web/src/features/tasks/**"
      ],
      "denyImports": [
        "apps/web/src/features/calendar/**"
      ],
      "severity": "error"
    }
  ]
}
