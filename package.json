{
  "name": "personal-workbench",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces --if-present",
    "test:workflows": "npm run test:workflows -w apps/api",
    "test:workflows:ci": "npm run test:workflows:ci -w apps/api",
    "test:r1a": "npm run test:r1a -w apps/api",
    "test:r1b": "npm run test:r1b -w apps/api",
    "test:r1d": "npm run test:r1d -w apps/api",
    "test:g5a": "npm run test:g5a -w apps/api",
    "test:g5b": "npm run test:g5b -w apps/api",
    "test:r2a": "npm run test:r2a -w apps/api",
    "test:r2b": "npm run test:r2b -w apps/api",
    "test:fin01": "npm run test:fin01 -w apps/api",
    "test:fin04": "npm run test:fin04 -w apps/api",
    "test:r2d1": "npm run test:r2d1 -w apps/api",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "npm run lint --workspaces",
    "db:up": "docker compose -p personal-workbench up -d mysql",
    "db:init": "mysql -h 127.0.0.1 -P 3307 -u workbench -pworkbench_password personal_workbench < db/migration/V1__init_schema.sql",
    "start": "npm run start -w apps/api"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
